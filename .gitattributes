# Auto detect text files and perform LF normalization
* text=auto


# Source files
# Rust
*.rs


# These files are text and should be normalized (Convert crlf => lf)
*.txt           text
*.properties    text
*.xml           text
*.svg           text
*.yml           text
*.yaml          text
*.json          text
*.md            text
*.toml          text
*.csv           text


# Scripts
# Windows / Linux / macOS
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.sh            text eol=lf


# Binary files
# Normal binaries
*.class         binary
*.dll           binary
*.ear           binary
*.so            binary
*.war           binary
*.jks           binary
*.ico           binary
*.wav           binary
*.png           binary
*.gif           binary

# zip archives
*.zip           binary
*.jar           binary


# GitHub
CODEOWNERS      text eol=lf
LICENSE         text eol=lf


# Exclude files from exporting
.gitattributes  export-ignore
.gitignore      export-ignore
.gitkeep        export-ignore
